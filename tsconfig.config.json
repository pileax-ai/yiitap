{
    "extends": "@tsconfig/node20/tsconfig.json",
    "include": [
        "vite.config.*",
        "vitest.config.*",
        "apps/*/vite.config.*",
        "apps/*/vitest.config.*",
        "packages/*/vite.config.*",
        "package/*/vitest.config.*",
        "cypress.config.*",
        "playwright.config.*"
    ],
    "compilerOptions": {
      "composite": true,
      "esModuleInterop": true,
      "types": ["node"]
    }
  }
